set(_root "${BUILD_DIR}/avahi-package-test")
file(REMOVE_RECURSE "${_root}")
set(_original "${_root}/original")
set(_relocated "${_root}/relocated")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}"
  --prefix "${_original}" --component Development --config "${CONFIG}"
  RESULT_VARIABLE _result)
if (_result)
  message(FATAL_ERROR "Fixture install failed: ${_result}")
endif()
file(RENAME "${_original}" "${_relocated}")
set(_package "${_relocated}/${LIBDIR}/cmake/AvahiFixture")
file(GLOB _cmake_files "${_package}/*.cmake")
foreach(_file IN LISTS _cmake_files)
  file(READ "${_file}" _content)
  foreach(_forbidden "${BUILD_DIR}" "${_original}")
    string(FIND "${_content}" "${_forbidden}" _found)
    if (NOT _found EQUAL -1)
      message(FATAL_ERROR "Build or original prefix leaked into ${_file}")
    endif()
  endforeach()
endforeach()
if (PROVIDER STREQUAL "SOURCE")
  foreach(_notice LICENSE NOTICE avahi-0.8.tar.gz)
    if (NOT EXISTS "${_relocated}/${DATADIR}/licenses/dmn/avahi/${_notice}")
      message(FATAL_ERROR "Missing Avahi source/license: ${_notice}")
    endif()
  endforeach()
  file(SHA256 "${_relocated}/${DATADIR}/licenses/dmn/avahi/avahi-0.8.tar.gz" _sha)
  if (NOT _sha STREQUAL "060309d7a333d38d951bc27598c677af1796934dbd98e1024e7ad8de798fedda")
    message(FATAL_ERROR "Installed Avahi source archive has the wrong hash")
  endif()
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${FIXTURE_DIR}/consumer"
  -B "${_root}/consumer" "-DCMAKE_PREFIX_PATH=${_relocated}"
  RESULT_VARIABLE _result)
if (_result)
  message(FATAL_ERROR "Relocated consumer configure failed: ${_result}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${_root}/consumer" --config "${CONFIG}"
  RESULT_VARIABLE _result)
if (_result)
  message(FATAL_ERROR "Relocated consumer build failed: ${_result}")
endif()
if (PROVIDER STREQUAL "SOURCE" AND
    EXISTS "${_root}/consumer/CMakeFiles/consumer.dir/link.txt")
  file(READ "${_root}/consumer/CMakeFiles/consumer.dir/link.txt" _link)
  string(FIND "${_link}" "${BUILD_DIR}/_deps/avahi-install" _found)
  if (NOT _found EQUAL -1)
    message(FATAL_ERROR "Consumer linked against the build-tree Avahi archives")
  endif()
endif()
set(_consumer "${_root}/consumer/consumer")
if (CONFIG AND EXISTS "${_root}/consumer/${CONFIG}/consumer")
  set(_consumer "${_root}/consumer/${CONFIG}/consumer")
endif()
execute_process(COMMAND "${_consumer}" RESULT_VARIABLE _result)
if (_result)
  message(FATAL_ERROR "Relocated consumer failed: ${_result}")
endif()
if (VALGRIND)
  execute_process(COMMAND "${VALGRIND}" --error-exitcode=1 --leak-check=full
    "${_consumer}" RESULT_VARIABLE _result)
  if (_result)
    message(FATAL_ERROR "Relocated consumer Valgrind failed: ${_result}")
  endif()
endif()
